{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadra",
  "version": "0.2.2",
  "identifier": "dev.quadra.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quadra",
        "width": 1188,
        "height": 744,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#090c0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/xray/*"
    ],
    "category": "Utility",
    "shortDescription": "VLESS client with a map",
    "longDescription": "A fast desktop client for VLESS and other Xray protocols: subscriptions, system proxy and all-traffic modes, and a world map that shows where your traffic goes.",
    "copyright": "MIT License",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "license": "MIT",
    "homepage": "https://github.com/Omibranch/quadra"
  }
}
